# Copy file này thành ".env" (cùng thư mục backend/) để chạy thử cục bộ,
# hoặc khai các biến này trong phần "Environment" của Render khi deploy thật.

# Bỏ trống hoặc xoá dòng này để dùng SQLite cục bộ (không cần NeonDB lúc dev).
# Dán connection string NeonDB vào đây khi deploy thật (dạng
# "postgres://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require").
DATABASE_URL=

# Chuỗi bí mật để ký JWT - đổi thành 1 chuỗi ngẫu nhiên dài (ví dụ chạy
# `python -c "import secrets; print(secrets.token_hex(32))"` để tạo).
JWT_SECRET=dev-secret-change-me-in-production

# KHÔNG có biến nào để cấu hình tài khoản - app đăng nhập bằng username +
# mật khẩu, 10 tài khoản mimi01..mimi10 (mật khẩu mặc định "Bong@1808") được
# TỰ ĐỘNG tạo mỗi lần server khởi động (xem `app/seed.py`, gọi từ
# `app/main.py`) - không đụng tới tài khoản đã đổi mật khẩu. Đổi mật khẩu
# ngay trong app (Cài đặt -> Đổi mật khẩu) sau khi đăng nhập lần đầu.

# API key Gemini (lấy tại https://aistudio.google.com/apikey) - để trống thì
# tính năng "Tâm sự với thú cưng"/"Từ điển" báo lỗi "chưa cấu hình" thay vì
# crash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Danh sách domain được phép gọi API này, cách nhau bằng dấu phẩy (KHÔNG để
# "*" khi đã public thật, vì lúc đó ai cũng gọi được API bằng token của
# chính họ - không phải lỗ hổng bảo mật nghiêm trọng nhưng nên giới hạn gọn).
# Ví dụ: http://localhost:8080,https://<ten-user>.github.io
ALLOWED_ORIGINS=*
